###############################################################################
# NutriLens — Laravel API environment template
#
# Copy this file to `.env`, then run `php artisan key:generate`.
#
# ⚠️  You MUST fill in DB_USERNAME and DB_PASSWORD with your own MySQL
#     credentials. The nutrilens_db database is expected to already exist.
###############################################################################

APP_NAME=NutriLens
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Origin of the Next.js frontend. Used for CORS + Sanctum stateful domains.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

#------------------------------------------------------------------------------
# Database — existing MySQL database created via phpMyAdmin
#------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nutrilens_db
DB_USERNAME=YOUR_MYSQL_USERNAME
DB_PASSWORD=YOUR_MYSQL_PASSWORD

#------------------------------------------------------------------------------
# Sanctum — bearer-token API authentication (no stateful cookie/CSRF flow)
# Leave SANCTUM_TOKEN_EXPIRATION empty for non-expiring tokens, or set a
# number of minutes (e.g. 43200 = 30 days).
#------------------------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

#------------------------------------------------------------------------------
# AI vision provider (meal photo analysis)
#
# AI_PROVIDER=fake   → no key, no network, no cost. Returns realistic sample
#                      analyses so the whole flow works offline.
# AI_PROVIDER=anthropic → set AI_API_KEY to an Anthropic key (sk-ant-...)
# AI_PROVIDER=openai    → set AI_API_KEY to an OpenAI key (sk-...)
#
# AI_MODEL is optional; leave blank to use the provider default
# (claude-opus-5 for anthropic, gpt-4o for openai).
#
# The key is read only by Laravel and is never sent to the Next.js frontend.
#------------------------------------------------------------------------------
AI_PROVIDER=fake
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=90
AI_IMAGE_MAX_EDGE=1568
AI_MAX_ITEMS=12
AI_FAKE_DELAY_MS=1400

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@nutrilens.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
#------------------------------------------------------------------------------
# Weekly AI insights (optional overrides)
#
# The same AI_PROVIDER / AI_API_KEY above drive weekly summaries; these only
# exist because writing short text over a small numeric payload is a cheaper
# job than reading a photograph. Leave AI_INSIGHTS_MODEL blank to reuse
# AI_MODEL.
#------------------------------------------------------------------------------
AI_INSIGHTS_MODEL=
AI_INSIGHTS_MAX_TOKENS=2000
AI_INSIGHTS_EFFORT=low

#------------------------------------------------------------------------------
# Swagger / OpenAPI documentation (partner API)
#
# L5_SWAGGER_GENERATE_ALWAYS regenerates the spec on every page load — handy in
# development, wasteful in production (run `php artisan l5-swagger:generate`
# during deployment instead).
# PERSIST_AUTHORIZATION keeps a pasted API key across Swagger UI reloads.
#------------------------------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_UI_PERSIST_AUTHORIZATION=true
L5_SWAGGER_CONST_HOST="${APP_URL}"

#------------------------------------------------------------------------------
# Structured food estimation (partner API, non-image endpoint)
#------------------------------------------------------------------------------
AI_ESTIMATION_MODEL=
AI_ESTIMATION_MAX_TOKENS=4000
AI_ESTIMATION_EFFORT=low
AI_ESTIMATION_MAX_ITEMS=20
